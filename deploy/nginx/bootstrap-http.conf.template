# ─────────────────────────────────────────────────────────────────────────────
#  aiameen.online — HTTP-only bootstrap site (used before the TLS cert exists)
#
#  deploy.sh installs this first so nginx can start, answer the Let's Encrypt
#  HTTP-01 challenge, and still serve the app over plain HTTP during the initial
#  setup window. Once the certificate is issued, deploy.sh swaps in the full
#  HTTPS config (which redirects :80 → :443).
# ─────────────────────────────────────────────────────────────────────────────

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ __WWW_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        allow all;
    }

    root __APP_ROOT__/public;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # PHP API (so the site is usable before HTTPS is in place)
    location ~ ^/api/([A-Za-z0-9_-]+)\.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME __APP_ROOT__/api/$1.php;
        fastcgi_param SCRIPT_NAME     /api/$1.php;
        fastcgi_pass unix:__PHP_SOCK__;
        fastcgi_read_timeout 30s;
    }

    location /api/ {
        return 404;
    }
}
