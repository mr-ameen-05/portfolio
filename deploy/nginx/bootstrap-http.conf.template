# ─────────────────────────────────────────────────────────────────────────────
#  aiameen.online — HTTP-only bootstrap site (used before the TLS cert exists)
#
#  deploy.sh installs this first so nginx can start, answer the Let's Encrypt
#  HTTP-01 challenge, and still serve the app over plain HTTP during the initial
#  setup window. Once the certificate is issued, deploy.sh swaps in the full
#  HTTPS config (which redirects :80 → :443).
# ─────────────────────────────────────────────────────────────────────────────

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ __WWW_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        allow all;
    }

    root __APP_ROOT__/public;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── Node.js Mailer API: /api/ -> http://127.0.0.1:3001 ──
    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 30s;
        proxy_connect_timeout 10s;
    }
}
