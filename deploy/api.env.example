# ─────────────────────────────────────────────────────────────────────────────
#  Runtime environment for the Node.js mailing API.
#  deploy.sh renders this into /etc/aiameen/api.env (chmod 640 root:www-data).
#  The Node.js server reads it at startup and request time.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3001
HOST=0.0.0.0

# ── Mail Dispatcher (Gmail SMTP) ──────────────────────────────────────────────
MAIL_TO=26alameen2005@gmail.com
MAIL_FROM_EMAIL=26alameen2005@gmail.com
MAIL_FROM_NAME="Al Ameen N R"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=26alameen2005@gmail.com
# Google App Password (16 characters, generate at: https://myaccount.google.com/apppasswords)
SMTP_PASS=

# ── Security & Telemetry ──────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=12
ALLOWED_ORIGINS=https://aiameen.online,https://www.aiameen.online
LOG_DIR=/var/log/aiameen
