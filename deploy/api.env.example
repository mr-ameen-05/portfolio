# ─────────────────────────────────────────────────────────────────────────────
#  Runtime environment for the PHP mailing API.
#  deploy.sh renders this into /etc/aiameen/api.env (chmod 640 root:www-data).
#  The PHP bootstrap reads it at request time. Do NOT commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aiameen
DB_USER=aiameen_app
DB_PASS=change-me-strong-password

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_TO=26alameen2005@gmail.com
MAIL_FROM_EMAIL=no-reply@aiameen.online
MAIL_FROM_NAME=aiameen.online
MAIL_TRANSPORT=smtp
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_DEBUG=0

# ── App ──────────────────────────────────────────────────────────────────────
QUIZ_SECRET=change-me-to-a-long-random-string
RATE_LIMIT_PER_MINUTE=20
ALLOWED_ORIGINS=https://aiameen.online,https://www.aiameen.online
LOG_DIR=/var/log/aiameen
