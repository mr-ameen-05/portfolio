# ─────────────────────────────────────────────────────────────────────────────
#  Runtime environment for the Node.js API.
#  deploy.sh renders this into /etc/aiameen/api.env (chmod 640 root:www-data).
#  The Node.js server reads it at startup and request time.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3001
HOST=0.0.0.0

# ── Google Sheets Dispatcher ──────────────────────────────────────────────────
# Paste your Google Apps Script Web App URL to log all enquiries directly to Google Sheets:
GOOGLE_SHEET_WEBHOOK_URL=
# Set to "true" only if you also want to send email copies via SMTP (default: false)
SEND_EMAIL=false

# ── Optional Mail Dispatcher (Gmail SMTP) ─────────────────────────────────────
SMTP_USER=your-email@gmail.com
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
MAIL_FROM_NAME="Al Ameen N R"
MAIL_FROM_EMAIL=
ADMIN_EMAIL=
RECEIVER_EMAIL=
MAIL_TO=

# ── Security & Telemetry ──────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=12
ALLOWED_ORIGINS=https://aiameen.online,https://www.aiameen.online
LOG_DIR=/var/log/aiameen
