# ─────────────────────────────────────────────────────────────────────────────
#  aiameen.online — deployment configuration
#
#  Copy this file, then edit the values:
#      cp deploy/deploy.env.example deploy/deploy.env
#
#  deploy/deploy.env is git-ignored and holds secrets. deploy.sh sources it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain & TLS ─────────────────────────────────────────────────────────────
DOMAIN="aiameen.online"
WWW_DOMAIN="www.aiameen.online"        # set INCLUDE_WWW=false (below) to skip it
INCLUDE_WWW="true"                     # also issue a cert / redirect for www
LETSENCRYPT_EMAIL="you@example.com"    # REQUIRED for HTTPS (Let's Encrypt)

# ── Server layout ────────────────────────────────────────────────────────────
APP_ROOT="/var/www/aiameen.online"     # public/ (static site) + api/ (PHP) live here
SITE_USER="www-data"                   # nginx + php-fpm run as this user
PHP_VERSION=""                         # leave empty to auto-detect the php-fpm socket

# ── MySQL ────────────────────────────────────────────────────────────────────
DB_NAME="aiameen"
DB_USER="aiameen_app"
DB_PASS="change-me-strong-password"
DB_HOST="127.0.0.1"
DB_PORT="3306"
# How deploy.sh authenticates to MySQL during setup:
#   socket   -> Ubuntu default (runs `mysql` as root over the unix socket)
#   password -> uses MYSQL_ROOT_PASSWORD
MYSQL_ROOT_AUTH="socket"
MYSQL_ROOT_PASSWORD=""

# ── Mailing system ───────────────────────────────────────────────────────────
MAIL_TO="26alameen2005@gmail.com"          # where form/enrollment notifications go
MAIL_FROM_EMAIL="no-reply@aiameen.online"  # must be a verified sender at your SMTP provider
MAIL_FROM_NAME="aiameen.online"
# Transport: "smtp" (recommended — AWS blocks outbound port 25) or "mail" (local MTA)
MAIL_TRANSPORT="smtp"
SMTP_HOST="email-smtp.ap-south-1.amazonaws.com"   # Amazon SES example
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_ENCRYPTION="tls"                      # "tls" for 587, "ssl" for 465
SMTP_DEBUG="0"

# ── API behaviour ────────────────────────────────────────────────────────────
QUIZ_SECRET="change-me-to-a-long-random-string"
RATE_LIMIT_PER_MINUTE="20"
ALLOWED_ORIGINS="https://aiameen.online,https://www.aiameen.online"

# ── Host provisioning toggles ────────────────────────────────────────────────
ENABLE_UFW="true"                      # configure ufw (SSH + Nginx Full)
CREATE_SWAP="true"                     # create 2G swap on small instances (avoids build OOM)
SKIP_BUILD="false"                     # true = reuse the existing ./dist instead of rebuilding
SSH_PORT="22"

# ── Dependency security (npm) ────────────────────────────────────────────────
# NPM_AUDIT_FIX        run `npm audit fix` before every build (non-breaking; respects semver)
# NPM_AUDIT_FIX_FORCE  also run `npm audit fix --force` (may introduce breaking upgrades)
NPM_AUDIT_FIX="true"
NPM_AUDIT_FIX_FORCE="false"

# ── Remote sync (only for `./deploy.sh sync` run from your laptop) ────────────
DEPLOY_HOST=""                         # e.g. ubuntu@203.0.113.10
DEPLOY_SSH_KEY="~/.ssh/aiameen.pem"    # path to the EC2 .pem key
DEPLOY_PATH="/srv/aiameen/portfolio"   # where the repo is copied on the server
