# Frontend environment variables (Vite).
#
# These are OPTIONAL. When unset, the app talks to the same origin under /api,
# which is exactly how the EC2 deployment is wired (nginx -> php-fpm):
#
#   VITE_CONTACT_ENDPOINT -> POST  /api/contact.php        (contact form)
#   VITE_ENROLL_ENDPOINT  -> POST  /api/course-enroll.php  (course gate)
#   VITE_QUIZ_ENDPOINT    -> POST  /api/course-quiz.php    (quiz grading)
#
# Enrollment and quiz submission degrade gracefully to on-device handling if a
# request fails, so the course is never blocked when the API is unreachable.
#
# Point them at a different host only if you split the API onto its own domain:
#   VITE_CONTACT_ENDPOINT=https://api.aiameen.online/contact
#   VITE_ENROLL_ENDPOINT=https://api.aiameen.online/enroll
#   VITE_QUIZ_ENDPOINT=https://api.aiameen.online/quiz

VITE_CONTACT_ENDPOINT=
VITE_ENROLL_ENDPOINT=
VITE_QUIZ_ENDPOINT=
