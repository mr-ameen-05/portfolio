# Local development values for the PHP API.
# Copy to api/.env  (never commit it). In production deploy.sh writes
# /etc/aiameen/api.env instead and this file is not used.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aiameen
DB_USER=aiameen_app
DB_PASS=change-me-strong-password

MAIL_TO=26alameen2005@gmail.com
MAIL_FROM_EMAIL=no-reply@aiameen.online
MAIL_FROM_NAME=aiameen.online
# Use "mail" locally if you have no SMTP provider configured.
MAIL_TRANSPORT=mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_DEBUG=0

QUIZ_SECRET=dev-only-not-secret
RATE_LIMIT_PER_MINUTE=60
ALLOWED_ORIGINS=http://localhost:5173
LOG_DIR=./tmp-logs

# Public base URL used to build links in account emails (verify / reset).
SITE_URL=http://localhost:5173
# Force Secure session cookies even over plain HTTP (keep false locally).
FORCE_SECURE_COOKIES=false
