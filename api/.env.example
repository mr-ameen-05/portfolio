# Local development values for the Node.js API.
# Copy to .env or api/.env. In production deploy.sh writes /etc/aiameen/api.env.

PORT=3001
HOST=0.0.0.0

# ── Google Sheets Dispatcher ──────────────────────────────────────────────────
# Paste your Google Apps Script Web App URL to log all enquiries directly to Google Sheets:
GOOGLE_SHEET_WEBHOOK_URL=
# Set to "true" only if you also want to send email copies via SMTP (default: false)
SEND_EMAIL=false

# ── Optional Mail Dispatcher (Gmail SMTP) ─────────────────────────────────────
MAIL_TO=26alameen2005@gmail.com
MAIL_FROM_EMAIL=26alameen2005@gmail.com
MAIL_FROM_NAME="Al Ameen N R"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=26alameen2005@gmail.com
SMTP_PASS=

# Security & Limits
RATE_LIMIT_PER_MINUTE=12
ALLOWED_ORIGINS=http://localhost:5173,https://aiameen.online,https://www.aiameen.online
