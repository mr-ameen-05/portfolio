# Local development values for the Node.js Mailer API.
# Copy to .env or api/.env. In production deploy.sh writes /etc/aiameen/api.env.

PORT=3001
HOST=0.0.0.0

# ── Gmail SMTP Dispatcher ─────────────────────────────────────────────────────
# Destination where new project enquiries are forwarded
MAIL_TO=26alameen2005@gmail.com

# Gmail account used to send the emails (must match SMTP_USER)
MAIL_FROM_EMAIL=26alameen2005@gmail.com
MAIL_FROM_NAME="Al Ameen N R"

# Gmail SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=26alameen2005@gmail.com
# Google App Password (16 chars generated at: https://myaccount.google.com/apppasswords)
SMTP_PASS=your-16-char-app-password

# Security & Limits
RATE_LIMIT_PER_MINUTE=12
ALLOWED_ORIGINS=http://localhost:5173,https://aiameen.online,https://www.aiameen.online
